{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": "src",
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "allowJs": false,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "composite": true,
    "paths": {
  "@/*": ["*"],
  "@features/*": ["features/*"],
  "@web/*": ["*"],
  "@/staff/*": ["staff/*"]
}

  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
